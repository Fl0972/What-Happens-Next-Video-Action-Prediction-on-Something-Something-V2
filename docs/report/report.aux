\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The two Track\nobreakspace  {}A temporal architectures. \textbf  {TSM} mixes time at every residual block, before spatial pooling, via the zero-parameter channel shift of Eq.\nobreakspace  {}\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:tsm}\unskip \@@italiccorr )}}. \textbf  {VFL} pools each frame first, then applies global self-attention over $T{+}1$ tokens. Their complementary inductive biases drive the ensemble gain.\relax }}{6}{figure.caption.31}\protected@file@percent }
\newlabel{fig:arch}{{1}{6}{The two Track~A temporal architectures. \textbf {TSM} mixes time at every residual block, before spatial pooling, via the zero-parameter channel shift of Eq.~\eqref {eq:tsm}. \textbf {VFL} pools each frame first, then applies global self-attention over $T{+}1$ tokens. Their complementary inductive biases drive the ensemble gain.\relax }{figure.caption.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces TSM progression: from the T=5 R18 baseline to the R50 rotating model. Correcting the frame count ($+3.34$\,pp) and then scaling the backbone ($+3.40$\,pp) are the two largest single steps. The T=8 R50 scale-up \emph  {regresses} because duplicated frames corrupt the TSM shift.\relax }}{6}{figure.caption.32}\protected@file@percent }
\newlabel{fig:backbone}{{2}{6}{TSM progression: from the T=5 R18 baseline to the R50 rotating model. Correcting the frame count ($+3.34$\,pp) and then scaling the backbone ($+3.40$\,pp) are the two largest single steps. The T=8 R50 scale-up \emph {regresses} because duplicated frames corrupt the TSM shift.\relax }{figure.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Per-model \texttt  {val\_dir} top-1/top-5 (Track\nobreakspace  {}A, all from scratch). Red bars: new models (TSM-ResNet50 and ablation series A--F). The R50 rotating model is the new best single model at $42.85\%$.\relax }}{6}{figure.caption.33}\protected@file@percent }
\newlabel{fig:permodel}{{3}{6}{Per-model \texttt {val\_dir} top-1/top-5 (Track~A, all from scratch). Red bars: new models (TSM-ResNet50 and ablation series A--F). The R50 rotating model is the new best single model at $42.85\%$.\relax }{figure.caption.33}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces TSM ablation: focal $\gamma $ sweep and SGDR schedule shape (all other settings frozen). Any focal weight beats CE by ${\approx }0.5$\,pp; the difference between $\gamma {=}1$ and $\gamma {=}2$ is within noise. SGDR $T_\text  {mult}$ has negligible effect ($<0.05$\,pp).\relax }}{6}{figure.caption.34}\protected@file@percent }
\newlabel{fig:abla_tsm}{{4}{6}{TSM ablation: focal $\gamma $ sweep and SGDR schedule shape (all other settings frozen). Any focal weight beats CE by ${\approx }0.5$\,pp; the difference between $\gamma {=}1$ and $\gamma {=}2$ is within noise. SGDR $T_\text {mult}$ has negligible effect ($<0.05$\,pp).\relax }{figure.caption.34}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces VFL ablations: Transformer depth (2 vs.\ 3 layers, $-1.08$\,pp for 2 layers), fold count (5 vs.\ 10, $-0.46$\,pp for 10 folds), and SGDR schedule shape ($\leq 0.12$\,pp effect). VFL is data-saturated at $k{=}5$ and benefits from a 3rd Transformer block.\relax }}{7}{figure.caption.35}\protected@file@percent }
\newlabel{fig:abla_vfl}{{5}{7}{VFL ablations: Transformer depth (2 vs.\ 3 layers, $-1.08$\,pp for 2 layers), fold count (5 vs.\ 10, $-0.46$\,pp for 10 folds), and SGDR schedule shape ($\leq 0.12$\,pp effect). VFL is data-saturated at $k{=}5$ and benefits from a 3rd Transformer block.\relax }{figure.caption.35}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Track\nobreakspace  {}A ensemble progression. Adding TSM-R50 to the previous 3-model R18 ensemble raises 44.03\% to 46.23\%; adding the CE-trained TSM ablation reaches \textbf  {46.75\%}. The R50 backbone is the dominant component ($-1.33$\,pp LOO).\relax }}{7}{figure.caption.36}\protected@file@percent }
\newlabel{fig:ensemble}{{6}{7}{Track~A ensemble progression. Adding TSM-R50 to the previous 3-model R18 ensemble raises 44.03\% to 46.23\%; adding the CE-trained TSM ablation reaches \textbf {46.75\%}. The R50 backbone is the dominant component ($-1.33$\,pp LOO).\relax }{figure.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Leave-one-out on the 5-model ensemble. The previous 3-model best (44.03\%) is the dashed reference. TSM-R50 contributes $-1.33$\,pp alone.\relax }}{7}{figure.caption.37}\protected@file@percent }
\newlabel{fig:loo}{{7}{7}{Leave-one-out on the 5-model ensemble. The previous 3-model best (44.03\%) is the dashed reference. TSM-R50 contributes $-1.33$\,pp alone.\relax }{figure.caption.37}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Per-class F1 (5-model best ensemble, \texttt  {val\_dir}). Directional single-object motions score highest; ``pretending'' and direction-ambiguous classes score lowest.\relax }}{7}{figure.caption.38}\protected@file@percent }
\newlabel{fig:perclass}{{8}{7}{Per-class F1 (5-model best ensemble, \texttt {val\_dir}). Directional single-object motions score highest; ``pretending'' and direction-ambiguous classes score lowest.\relax }{figure.caption.38}{}}
