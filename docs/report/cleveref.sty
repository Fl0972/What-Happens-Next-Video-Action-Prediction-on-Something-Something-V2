% Minimal stub of cleveref.sty — provides the cross-reference commands cvpr.sty
% configures, falling back to plain \ref. Sufficient when the document does not
% rely on cleveref's automatic type prefixes.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cleveref}[2024/01/01 v0.0 minimal stub]
\DeclareOption*{}\ProcessOptions\relax
\newcommand{\cref}[1]{\ref{#1}}
\newcommand{\Cref}[1]{\ref{#1}}
\newcommand{\crefname}[3]{}
\newcommand{\Crefname}[3]{}
\newcommand{\cpageref}[1]{\pageref{#1}}
\newcommand{\Cpageref}[1]{\pageref{#1}}
\newcommand{\labelcref}[1]{\ref{#1}}
\endinput
