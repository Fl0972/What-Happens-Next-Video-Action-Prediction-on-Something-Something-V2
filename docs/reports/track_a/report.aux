\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The two complementary Track\nobreakspace  {}A temporal mechanisms. \textbf  {TSM} mixes time \emph  {locally} via parameter-free channel shifts in every ResNet block; \textbf  {VideoFormer-Lite} mixes time \emph  {globally} via \texttt  {[CLS]}-token attention over the four frame tokens. Their orthogonal biases drive the ensemble gain (Sec.\nobreakspace  {}\ref  {sec:trackA}).\relax }}{6}{figure.caption.25}\protected@file@percent }
\newlabel{fig:arch}{{1}{6}{The two complementary Track~A temporal mechanisms. \textbf {TSM} mixes time \emph {locally} via parameter-free channel shifts in every ResNet block; \textbf {VideoFormer-Lite} mixes time \emph {globally} via \texttt {[CLS]}-token attention over the four frame tokens. Their orthogonal biases drive the ensemble gain (Sec.~\ref {sec:trackA}).\relax }{figure.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Per-model \texttt  {val\_dir} top-1/top-5 (Track\nobreakspace  {}A). Correcting the frame count (TSM-Ultra$\rightarrow $TSM-Ultra-v2) is the single largest per-model jump; the ResNet-50/$T{=}8$ scale-up regresses (Sec.\nobreakspace  {}\ref  {sec:results}).\relax }}{6}{figure.caption.26}\protected@file@percent }
\newlabel{fig:permodel}{{2}{6}{Per-model \texttt {val\_dir} top-1/top-5 (Track~A). Correcting the frame count (TSM-Ultra$\rightarrow $TSM-Ultra-v2) is the single largest per-model jump; the ResNet-50/$T{=}8$ scale-up regresses (Sec.~\ref {sec:results}).\relax }{figure.caption.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Track\nobreakspace  {}A ensemble vs.\ its components. Log-softmax late fusion of two TSM variants and one VFL variant (all +TTA) exceeds the best single model by $+2.35$\,pp top-1, reaching $44.03\%$ \texttt  {val\_dir}.\relax }}{6}{figure.caption.27}\protected@file@percent }
\newlabel{fig:ensemble}{{3}{6}{Track~A ensemble vs.\ its components. Log-softmax late fusion of two TSM variants and one VFL variant (all +TTA) exceeds the best single model by $+2.35$\,pp top-1, reaching $44.03\%$ \texttt {val\_dir}.\relax }{figure.caption.27}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Track\nobreakspace  {}A leave-one-out study (\texttt  {val\_dir} top-1). All three members are necessary; the weakest standalone model (VFL) still adds value through error decorrelation (Table\nobreakspace  {}\ref  {tab:loo}).\relax }}{6}{figure.caption.28}\protected@file@percent }
\newlabel{fig:loo}{{4}{6}{Track~A leave-one-out study (\texttt {val\_dir} top-1). All three members are necessary; the weakest standalone model (VFL) still adds value through error decorrelation (Table~\ref {tab:loo}).\relax }{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Effect of 10-crop spatial TTA on Track\nobreakspace  {}A models. TTA adds ${\sim }1$\,pp on the strongest checkpoint and is essential at the ensemble level, where independent random errors from different crops average out (Sec.\nobreakspace  {}\ref  {sec:trackA}).\relax }}{6}{figure.caption.29}\protected@file@percent }
\newlabel{fig:tta}{{5}{6}{Effect of 10-crop spatial TTA on Track~A models. TTA adds ${\sim }1$\,pp on the strongest checkpoint and is essential at the ensemble level, where independent random errors from different crops average out (Sec.~\ref {sec:trackA}).\relax }{figure.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces TTA directional-class trade-off. Horizontal-flip TTA improves most classes but hurts a few direction-encoded ones (\emph  {Pulling left$\rightarrow $right} vs.\ \emph  {right$\rightarrow $left}) even after the flip-aware logit remap, because mirror evidence is intrinsically ambiguous when motion is short.\relax }}{7}{figure.caption.30}\protected@file@percent }
\newlabel{fig:ttatradeoff}{{6}{7}{TTA directional-class trade-off. Horizontal-flip TTA improves most classes but hurts a few direction-encoded ones (\emph {Pulling left$\rightarrow $right} vs.\ \emph {right$\rightarrow $left}) even after the flip-aware logit remap, because mirror evidence is intrinsically ambiguous when motion is short.\relax }{figure.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Rotating-fold training. Re-training the strongest checkpoint on every train/val fold yields snapshots that share weights but disagree on the boundary, contributing uncorrelated errors that the log-softmax ensemble exploits (Sec.\nobreakspace  {}\ref  {sec:trackA}).\relax }}{7}{figure.caption.31}\protected@file@percent }
\newlabel{fig:rotating}{{7}{7}{Rotating-fold training. Re-training the strongest checkpoint on every train/val fold yields snapshots that share weights but disagree on the boundary, contributing uncorrelated errors that the log-softmax ensemble exploits (Sec.~\ref {sec:trackA}).\relax }{figure.caption.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Backbone scale-up does not compensate for corrupted temporal input. Switching from ResNet-18/$T{=}4$ to ResNet-50/$T{=}8$ regresses internal validation by ${\sim }8$\,pp because the larger $T$ triggers frame interpolation (Sec.\nobreakspace  {}\ref  {sec:trackA}).\relax }}{7}{figure.caption.32}\protected@file@percent }
\newlabel{fig:backbone}{{8}{7}{Backbone scale-up does not compensate for corrupted temporal input. Switching from ResNet-18/$T{=}4$ to ResNet-50/$T{=}8$ regresses internal validation by ${\sim }8$\,pp because the larger $T$ triggers frame interpolation (Sec.~\ref {sec:trackA}).\relax }{figure.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Track\nobreakspace  {}B honest Kaggle progression. The discarded leaky submission ($0.81$, red) is plotted alongside every clean ensemble; each gain comes from adding architecturally distinct members, not from re-weighting. The dashed line marks the second-place public reference ($0.74$); the gap to it bounds what self-supervised pretraining + diverse ensembling buys us (Sec.\nobreakspace  {}\ref  {sec:results}, Table\nobreakspace  {}\ref  {tab:kaggle}).\relax }}{7}{figure.caption.33}\protected@file@percent }
\newlabel{fig:kagglejourney}{{9}{7}{Track~B honest Kaggle progression. The discarded leaky submission ($0.81$, red) is plotted alongside every clean ensemble; each gain comes from adding architecturally distinct members, not from re-weighting. The dashed line marks the second-place public reference ($0.74$); the gap to it bounds what self-supervised pretraining + diverse ensembling buys us (Sec.~\ref {sec:results}, Table~\ref {tab:kaggle}).\relax }{figure.caption.33}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces V-JEPA progressive unfreezing + LLRD (Track\nobreakspace  {}B internal val). Each phase warm-starts above the previous plateau: frozen probe ($0.55\!\to \!0.67$), then top-6 unfrozen + LLRD ($0.68\!\to \!0.71$), then full encoder ($0.70\!\to \!0.73$), then pseudo-label retrain ($0.72\!\to \!0.74$). The staircase pattern is the visual signature that LLRD has preserved each phase's feature geometry (Sec.\nobreakspace  {}\ref  {sec:trackB}).\relax }}{7}{figure.caption.34}\protected@file@percent }
\newlabel{fig:vjepacurves}{{10}{7}{V-JEPA progressive unfreezing + LLRD (Track~B internal val). Each phase warm-starts above the previous plateau: frozen probe ($0.55\!\to \!0.67$), then top-6 unfrozen + LLRD ($0.68\!\to \!0.71$), then full encoder ($0.70\!\to \!0.73$), then pseudo-label retrain ($0.72\!\to \!0.74$). The staircase pattern is the visual signature that LLRD has preserved each phase's feature geometry (Sec.~\ref {sec:trackB}).\relax }{figure.caption.34}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Where shipped \texttt  {frame\_003} sits in the source SSv2 clip (fraction). The dashed line at $0.40$ is the median end-of-window; the shaded region $[0.50,1.00]$ is the withheld outcome --- our re-extraction is hard-bounded to the un-shaded region (Sec.\nobreakspace  {}\ref  {sec:integrity}).\relax }}{8}{figure.caption.35}\protected@file@percent }
\newlabel{fig:framehist}{{11}{8}{Where shipped \texttt {frame\_003} sits in the source SSv2 clip (fraction). The dashed line at $0.40$ is the median end-of-window; the shaded region $[0.50,1.00]$ is the withheld outcome --- our re-extraction is hard-bounded to the un-shaded region (Sec.~\ref {sec:integrity}).\relax }{figure.caption.35}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Track\nobreakspace  {}B Kaggle vs.\ ensemble size. Returns from adding diverse honest members are still positive at $n{=}14$; at $n{=}6$, dropping K400 + TSM \emph  {hurts} despite their lower individual scores, because their uncorrelated errors disappear from the average (Table\nobreakspace  {}\ref  {tab:strategy}).\relax }}{8}{figure.caption.36}\protected@file@percent }
\newlabel{fig:enssize}{{12}{8}{Track~B Kaggle vs.\ ensemble size. Returns from adding diverse honest members are still positive at $n{=}14$; at $n{=}6$, dropping K400 + TSM \emph {hurts} despite their lower individual scores, because their uncorrelated errors disappear from the average (Table~\ref {tab:strategy}).\relax }{figure.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Learned ensemble weights collapse onto the two strongest members (${\sim }82\%$ of mass on \texttt  {large\_attempt1\_top2} and \texttt  {ssv2\_top1}), effectively zeroing K400 contributions. This is exactly why a learned weighting fails to beat uniform: it discards the very decorrelation signal that diverse weaker members provide (Sec.\nobreakspace  {}\ref  {sec:results}).\relax }}{8}{figure.caption.37}\protected@file@percent }
\newlabel{fig:learnedw}{{13}{8}{Learned ensemble weights collapse onto the two strongest members (${\sim }82\%$ of mass on \texttt {large\_attempt1\_top2} and \texttt {ssv2\_top1}), effectively zeroing K400 contributions. This is exactly why a learned weighting fails to beat uniform: it discards the very decorrelation signal that diverse weaker members provide (Sec.~\ref {sec:results}).\relax }{figure.caption.37}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Per-class F1 (ensemble, \texttt  {val\_dir}). Directional single-object motions score highest; ``pretending'' and direction-ambiguous classes score lowest (Sec.\nobreakspace  {}\ref  {sec:failure}).\relax }}{9}{figure.caption.38}\protected@file@percent }
\newlabel{fig:perclass}{{14}{9}{Per-class F1 (ensemble, \texttt {val\_dir}). Directional single-object motions score highest; ``pretending'' and direction-ambiguous classes score lowest (Sec.~\ref {sec:failure}).\relax }{figure.caption.38}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces $33\times 33$ confusion matrix (ensemble, \texttt  {val\_dir}). Off-diagonal mass concentrates on semantically adjacent pairs (real vs.\ pretended; fold vs.\ unfold; motion vs.\ \emph  {holding}).\relax }}{10}{figure.caption.39}\protected@file@percent }
