\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The two complementary Track\nobreakspace  {}A temporal mechanisms. \textbf  {TSM} mixes time \emph  {locally} via parameter-free channel shifts in every ResNet block, \emph  {before} spatial pooling; \textbf  {VideoFormer-Lite} mixes time \emph  {globally} via \texttt  {[CLS]}-token attention over pooled frame descriptors. The controlled comparison in Sec.\nobreakspace  {}\ref  {sec:abl} shows the former wins by $+3.0$\,pp at matched backbone size (Sec.\nobreakspace  {}\ref  {sec:trackA}).\relax }}{6}{figure.caption.27}\protected@file@percent }
\newlabel{fig:arch}{{1}{6}{The two complementary Track~A temporal mechanisms. \textbf {TSM} mixes time \emph {locally} via parameter-free channel shifts in every ResNet block, \emph {before} spatial pooling; \textbf {VideoFormer-Lite} mixes time \emph {globally} via \texttt {[CLS]}-token attention over pooled frame descriptors. The controlled comparison in Sec.~\ref {sec:abl} shows the former wins by $+3.0$\,pp at matched backbone size (Sec.~\ref {sec:trackA}).\relax }{figure.caption.27}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces TSM backbone and frame-count progression on \texttt  {val\_dir}. The $T{=}8$ ResNet50 attempt regresses because interpolation duplicates frames; restoring $T{=}4$ and scaling to ResNet50 with rotating folds instead adds $+3.4$\,pp over the matched ResNet18, reaching the new single-model best of $42.85\%$ (Sec.\nobreakspace  {}\ref  {sec:trackA}).\relax }}{6}{figure.caption.28}\protected@file@percent }
\newlabel{fig:backbone}{{2}{6}{TSM backbone and frame-count progression on \texttt {val\_dir}. The $T{=}8$ ResNet50 attempt regresses because interpolation duplicates frames; restoring $T{=}4$ and scaling to ResNet50 with rotating folds instead adds $+3.4$\,pp over the matched ResNet18, reaching the new single-model best of $42.85\%$ (Sec.~\ref {sec:trackA}).\relax }{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Per-model \texttt  {val\_dir} top-1/top-5 (Track\nobreakspace  {}A). Correcting the frame count (TSM-Ultra$\rightarrow $TSM-Ultra-v2) and then scaling the backbone to ResNet50 (rotating folds) are the two largest per-model jumps; the $T{=}8$ ResNet50 scale-up regresses (Sec.\nobreakspace  {}\ref  {sec:results}).\relax }}{6}{figure.caption.29}\protected@file@percent }
\newlabel{fig:permodel}{{3}{6}{Per-model \texttt {val\_dir} top-1/top-5 (Track~A). Correcting the frame count (TSM-Ultra$\rightarrow $TSM-Ultra-v2) and then scaling the backbone to ResNet50 (rotating folds) are the two largest per-model jumps; the $T{=}8$ ResNet50 scale-up regresses (Sec.~\ref {sec:results}).\relax }{figure.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces TSM ablations: focal-$\gamma $ sweep and SGDR restart shape (all other settings frozen). Any focal weight beats CE by ${\approx }0.5$\,pp; $\gamma {=}1$ and $\gamma {=}2$ are within noise; SGDR $T_\text  {mult}$ has negligible effect ($<0.05$\,pp) (Sec.\nobreakspace  {}\ref  {sec:abl}).\relax }}{6}{figure.caption.30}\protected@file@percent }
\newlabel{fig:abla_tsm}{{4}{6}{TSM ablations: focal-$\gamma $ sweep and SGDR restart shape (all other settings frozen). Any focal weight beats CE by ${\approx }0.5$\,pp; $\gamma {=}1$ and $\gamma {=}2$ are within noise; SGDR $T_\text {mult}$ has negligible effect ($<0.05$\,pp) (Sec.~\ref {sec:abl}).\relax }{figure.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces VFL ablations: Transformer depth (2 vs.\ 3 layers, $-1.08$\,pp for 2 layers), fold count (5 vs.\ 10, $-0.46$\,pp for 10 folds --- VFL is data-saturated at $k{=}5$), and SGDR restart shape ($\leq 0.12$\,pp effect) (Sec.\nobreakspace  {}\ref  {sec:abl}).\relax }}{7}{figure.caption.31}\protected@file@percent }
\newlabel{fig:abla_vfl}{{5}{7}{VFL ablations: Transformer depth (2 vs.\ 3 layers, $-1.08$\,pp for 2 layers), fold count (5 vs.\ 10, $-0.46$\,pp for 10 folds --- VFL is data-saturated at $k{=}5$), and SGDR restart shape ($\leq 0.12$\,pp effect) (Sec.~\ref {sec:abl}).\relax }{figure.caption.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Track\nobreakspace  {}A ensemble vs.\ its components. Log-softmax late fusion of two TSM-ResNet18 variants, one VFL variant (all +TTA), the new TSM-ResNet50 and a CE-trained TSM ablation (no TTA) reaches $46.75\%$ \texttt  {val\_dir} and $0.4785$ public / $0.4547$ private on Kaggle --- our best closed-track submission (Sec.\nobreakspace  {}\ref  {sec:rotating}).\relax }}{7}{figure.caption.32}\protected@file@percent }
\newlabel{fig:ensemble}{{6}{7}{Track~A ensemble vs.\ its components. Log-softmax late fusion of two TSM-ResNet18 variants, one VFL variant (all +TTA), the new TSM-ResNet50 and a CE-trained TSM ablation (no TTA) reaches $46.75\%$ \texttt {val\_dir} and $0.4785$ public / $0.4547$ private on Kaggle --- our best closed-track submission (Sec.~\ref {sec:rotating}).\relax }{figure.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Track\nobreakspace  {}A leave-one-out study on the 5-model ensemble (\texttt  {val\_dir} top-1). The ResNet50 backbone is the dominant contributor ($-1.33$\,pp), ahead of the architecturally distinct VFL ($-0.64$\,pp): backbone diversity outweighs family diversity here (Table\nobreakspace  {}\ref  {tab:loo}).\relax }}{7}{figure.caption.33}\protected@file@percent }
\newlabel{fig:loo}{{7}{7}{Track~A leave-one-out study on the 5-model ensemble (\texttt {val\_dir} top-1). The ResNet50 backbone is the dominant contributor ($-1.33$\,pp), ahead of the architecturally distinct VFL ($-0.64$\,pp): backbone diversity outweighs family diversity here (Table~\ref {tab:loo}).\relax }{figure.caption.33}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Effect of 10-crop spatial TTA on Track\nobreakspace  {}A models. TTA adds ${\sim }1$\,pp on the strongest checkpoint and is essential at the ensemble level, where independent random errors from different crops average out (Sec.\nobreakspace  {}\ref  {sec:trackA}).\relax }}{7}{figure.caption.34}\protected@file@percent }
\newlabel{fig:tta}{{8}{7}{Effect of 10-crop spatial TTA on Track~A models. TTA adds ${\sim }1$\,pp on the strongest checkpoint and is essential at the ensemble level, where independent random errors from different crops average out (Sec.~\ref {sec:trackA}).\relax }{figure.caption.34}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces TTA directional-class trade-off. Horizontal-flip TTA improves most classes but hurts a few direction-encoded ones (\emph  {Pulling left$\rightarrow $right} vs.\ \emph  {right$\rightarrow $left}) even after the flip-aware logit remap, because mirror evidence is intrinsically ambiguous when motion is short.\relax }}{7}{figure.caption.35}\protected@file@percent }
\newlabel{fig:ttatradeoff}{{9}{7}{TTA directional-class trade-off. Horizontal-flip TTA improves most classes but hurts a few direction-encoded ones (\emph {Pulling left$\rightarrow $right} vs.\ \emph {right$\rightarrow $left}) even after the flip-aware logit remap, because mirror evidence is intrinsically ambiguous when motion is short.\relax }{figure.caption.35}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Rotating-fold training. Re-training the strongest checkpoints on every train/val fold yields snapshots that share weights but disagree on the boundary, contributing uncorrelated errors that the log-softmax ensemble exploits; the gain is larger for VFL ($+4.3$\,pp) than for TSM ($+1.2$\,pp) (Sec.\nobreakspace  {}\ref  {sec:rotating}).\relax }}{7}{figure.caption.36}\protected@file@percent }
\newlabel{fig:rotating}{{10}{7}{Rotating-fold training. Re-training the strongest checkpoints on every train/val fold yields snapshots that share weights but disagree on the boundary, contributing uncorrelated errors that the log-softmax ensemble exploits; the gain is larger for VFL ($+4.3$\,pp) than for TSM ($+1.2$\,pp) (Sec.~\ref {sec:rotating}).\relax }{figure.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Track\nobreakspace  {}B honest Kaggle progression. The discarded leaky submission ($0.81$, red) is plotted alongside every clean ensemble; each gain comes from adding architecturally distinct members, not from re-weighting. The dashed line marks the second-place public reference ($0.74$); the gap to it bounds what self-supervised pretraining + diverse ensembling buys us (Sec.\nobreakspace  {}\ref  {sec:results}, Table\nobreakspace  {}\ref  {tab:kaggle}).\relax }}{8}{figure.caption.37}\protected@file@percent }
\newlabel{fig:kagglejourney}{{11}{8}{Track~B honest Kaggle progression. The discarded leaky submission ($0.81$, red) is plotted alongside every clean ensemble; each gain comes from adding architecturally distinct members, not from re-weighting. The dashed line marks the second-place public reference ($0.74$); the gap to it bounds what self-supervised pretraining + diverse ensembling buys us (Sec.~\ref {sec:results}, Table~\ref {tab:kaggle}).\relax }{figure.caption.37}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces V-JEPA progressive unfreezing + LLRD (Track\nobreakspace  {}B internal val). Each phase warm-starts above the previous plateau: frozen probe ($0.55\!\to \!0.67$), then top-6 unfrozen + LLRD ($0.68\!\to \!0.71$), then full encoder ($0.70\!\to \!0.73$), then pseudo-label retrain ($0.72\!\to \!0.74$). The staircase pattern is the visual signature that LLRD has preserved each phase's feature geometry (Sec.\nobreakspace  {}\ref  {sec:trackB}).\relax }}{8}{figure.caption.38}\protected@file@percent }
\newlabel{fig:vjepacurves}{{12}{8}{V-JEPA progressive unfreezing + LLRD (Track~B internal val). Each phase warm-starts above the previous plateau: frozen probe ($0.55\!\to \!0.67$), then top-6 unfrozen + LLRD ($0.68\!\to \!0.71$), then full encoder ($0.70\!\to \!0.73$), then pseudo-label retrain ($0.72\!\to \!0.74$). The staircase pattern is the visual signature that LLRD has preserved each phase's feature geometry (Sec.~\ref {sec:trackB}).\relax }{figure.caption.38}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Where shipped \texttt  {frame\_003} sits in the source SSv2 clip (fraction). The dashed line at $0.40$ is the median end-of-window; the shaded region $[0.50,1.00]$ is the withheld outcome --- our re-extraction is hard-bounded to the un-shaded region (Sec.\nobreakspace  {}\ref  {sec:integrity}).\relax }}{8}{figure.caption.39}\protected@file@percent }
\newlabel{fig:framehist}{{13}{8}{Where shipped \texttt {frame\_003} sits in the source SSv2 clip (fraction). The dashed line at $0.40$ is the median end-of-window; the shaded region $[0.50,1.00]$ is the withheld outcome --- our re-extraction is hard-bounded to the un-shaded region (Sec.~\ref {sec:integrity}).\relax }{figure.caption.39}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Track\nobreakspace  {}B Kaggle vs.\ ensemble size. Returns from adding diverse honest members are still positive at $n{=}14$; at $n{=}6$, dropping K400 + TSM \emph  {hurts} despite their lower individual scores, because their uncorrelated errors disappear from the average (Table\nobreakspace  {}\ref  {tab:strategy}).\relax }}{8}{figure.caption.40}\protected@file@percent }
\newlabel{fig:enssize}{{14}{8}{Track~B Kaggle vs.\ ensemble size. Returns from adding diverse honest members are still positive at $n{=}14$; at $n{=}6$, dropping K400 + TSM \emph {hurts} despite their lower individual scores, because their uncorrelated errors disappear from the average (Table~\ref {tab:strategy}).\relax }{figure.caption.40}{}}
